{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camp-gear-manager",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/app-config.js"]
  },
  "vars": { "ENABLE_EMAIL_AUTH": "false", "ALLOWED_ORIGINS": "" }
}
